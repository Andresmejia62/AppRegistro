<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0" prefWidth="760.0" style="-fx-background-color: #fff2d9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.appregistros.appregistro.controller.Consultaclientecontroller">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Consulta de clientes" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre o apellido" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBuscar" onAction="#buscarCliente" text="Buscar" />
                    </children>
                </HBox>
                <Label text="Doble clic sobre un cliente para ver el detalle." style="-fx-font-size: 11px; -fx-text-fill: #666;" />
                <TableView fx:id="tblClientes" prefHeight="280.0" onMouseClicked="#manejarDobleClic" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                        <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="100.0" text="Tipo cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="110.0" text="F. nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="110.0" text="Tipo solicitud" />
                    </columns>
                </TableView>
                <Button fx:id="btnVolver" onAction="#volver" prefWidth="100.0" text="Volver" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>