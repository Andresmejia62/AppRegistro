<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.appregistros.appregistro.controller.Ventanaprincipalcontroller"
            prefHeight="450.0" prefWidth="650.0">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="Salir" onAction="#salir"/>
                </Menu>
                <Menu text="Clientes">
                    <MenuItem text="Registrar cliente" onAction="#abrirRegistro"/>
                    <MenuItem text="Consultar clientes" onAction="#abrirConsulta"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button fx:id="btnRegistrarCliente" text="Registrar cliente" onAction="#abrirRegistro"/>
                <Button fx:id="btnConsultarClientes" text="Consultar clientes" onAction="#abrirConsulta"/>
                <Button fx:id="btnSalir" text="Salir" onAction="#salir"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="40" bottom="40" left="40" right="40"/>
            </padding>
            <Label fx:id="lblBienvenida" text="Bienvenido al sistema" style="-fx-font-size: 22px; -fx-font-weight: bold;">
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="Ver información" onAction="#mostrarInfo"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </Label>
            <Label text="Use el menú, la barra de herramientas o clic derecho sobre el título."/>
        </VBox>
    </center>
</BorderPane>